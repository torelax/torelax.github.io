---
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
const posts = (await getAllPosts()).sort(collectionDateSort).slice(0, 10);
---
<PageLayout meta={{ title: "首页" }}>
  <section>
    <h1 class="title mb-12">你好，我是 torelax。</h1>
    <p class="mb-4">这里收录公开的项目、技术笔记与文章。</p>
    <SocialList />
  </section>
  <section class="mt-16">
    <h2 class="title text-accent mb-6 text-xl"><a href="/posts/">文章</a></h2>
    <ul class="space-y-4" role="list">
      {posts.map((post) => <li class="grid gap-1 sm:grid-cols-[auto_1fr]"><PostPreview post={post} /></li>)}
    </ul>
  </section>
  <section class="mt-16">
    <h2 class="title text-accent mb-6 text-xl"><a href="/projects/">项目</a></h2>
    <p class="text-muted">暂无公开项目。</p>
  </section>
</PageLayout>
